												"$ref": "AAAAAAGgrThaxSrqzVU="
											},
											"lineStyle": 1,
											"points": "1091:723;1255:934",
											"showVisibility": true,
											"nameLabel": {
												"$ref": "AAAAAAGguBS7rRiNuR4="
											},
											"stereotypeLabel": {
												"$ref": "AAAAAAGguBS7rRiOPlM="
