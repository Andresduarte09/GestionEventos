												"$ref": "AAAAAAGguBS7rRiWNa8="
											},
											"headQualifiersCompartment": {
												"$ref": "AAAAAAGguBS7rRiXm5I="
											}
										},
										{
											"_type": "UMLTextView",
											"_id": "AAAAAAGgu3Xg+9Zb0XQ=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;13;0",
											"parentStyle": false,
											"left": 1736,
											"top": 1904,
											"width": 166,
											"height": 131,
											"text": "Representa el encabezado del documento económico generado a partir de la propuesta seleccionada. Maneja los acumulados generales (subtotal, IVA, montos de descuento) y consolida las versiones emitidas para el cliente."
										},
										{
											"_type": "UMLTextView",
											"_id": "AAAAAAGgu3Z1H6EaA4I=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;13;0",
											"parentStyle": false,
											"left": 1664,
											"top": 2336,
											"width": 152,
											"height": 129,
											"text": "Garantiza la trazabilidad del proceso. Cada vez que el cliente solicita cambios o modificaciones a la propuesta (en precios, recursos o servicios), se crea un nuevo registro histórico de versión."
										},
										{
											"_type": "UMLTextView",
											"_id": "AAAAAAGgu3gUI9hA9S4=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;13;0",
											"parentStyle": false,
											"left": 624,
											"top": 2416,
											"width": 155,
											"height": 120,
											"text": "Almacena el desglose ítem por ítem de los conceptos, recursos, personal y servicios específicos incluidos en la cotización, con sus respectivos importes individuales."
										},
										{
											"_type": "UMLTextView",
											"_id": "AAAAAAGgu3rzwCHFzvI=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;13;0",
											"parentStyle": false,
											"left": 1560,
											"top": 704,
											"width": 144,
											"height": 95,
											"text": "Representa el catálogo base de servicios y recursos ofrecidos por la empresa, junto con sus precios unitarios y tarifas de referencia."
										},
										{
											"_type": "UMLTextView",
											"_id": "AAAAAAGgu3soA4AjKLY=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;13;0",
											"parentStyle": false,
											"left": 1032,
											"top": 2208,
											"width": 201,
											"height": 116,
											"text": "Representa el producto final del CU-01 (generado en F5). Contiene exclusivamente los conceptos y recursos que fueron autorizados/aceptados por el cliente. Guarda referencia directa con la cotización, cliente y el asesor responsable."
										},
